# AstroAI runtime configuration
ASTROAI_ENVIRONMENT=development
ASTROAI_APP_NAME=AstroAI
ASTROAI_APP_VERSION=1.0.0-beta.1
ASTROAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ASTROAI_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
ASTROAI_DOCS_ENABLED=true
ASTROAI_REQUEST_ID_HEADER=X-Request-ID

# Production example:
# ASTROAI_ENVIRONMENT=production
# ASTROAI_CORS_ORIGINS=https://app.example.com
# ASTROAI_TRUSTED_HOSTS=api.example.com
# ASTROAI_DOCS_ENABLED=false
