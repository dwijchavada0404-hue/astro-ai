# AstroAI runtime configuration
ASTROAI_ENVIRONMENT=development
ASTROAI_APP_NAME=AstroAI
ASTROAI_APP_VERSION=1.0.0-beta.1
ASTROAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ASTROAI_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
ASTROAI_DOCS_ENABLED=true
ASTROAI_REQUEST_ID_HEADER=X-Request-ID
ASTROAI_MAX_REQUEST_BODY_BYTES=1048576
ASTROAI_SECURITY_HEADERS_ENABLED=true
ASTROAI_RATE_LIMIT_ENABLED=true
ASTROAI_RATE_LIMIT_REQUESTS_PER_MINUTE=120
ASTROAI_REQUEST_LOGGING_ENABLED=true
ASTROAI_SLOW_REQUEST_THRESHOLD_MS=2000

# Authentication / identity boundary
ASTROAI_AUTH_ENABLED=false
ASTROAI_API_AUTH_REQUIRED=false
ASTROAI_AUTH_JWT_SECRET=
ASTROAI_AUTH_JWKS_URL=
ASTROAI_AUTH_JWT_ALGORITHM=HS256
ASTROAI_AUTH_JWT_ISSUER=astroai
ASTROAI_AUTH_JWT_AUDIENCE=astroai-api

# Persistent user/birth profiles
ASTROAI_PROFILE_DATABASE_PATH=data/astroai_profiles.db

# Production example:
# ASTROAI_ENVIRONMENT=production
# ASTROAI_CORS_ORIGINS=https://app.example.com
# ASTROAI_TRUSTED_HOSTS=api.example.com
# ASTROAI_DOCS_ENABLED=false
# ASTROAI_MAX_REQUEST_BODY_BYTES=1048576
# ASTROAI_SECURITY_HEADERS_ENABLED=true
# ASTROAI_RATE_LIMIT_ENABLED=true
# ASTROAI_RATE_LIMIT_REQUESTS_PER_MINUTE=120
# ASTROAI_REQUEST_LOGGING_ENABLED=true
# ASTROAI_SLOW_REQUEST_THRESHOLD_MS=2000
# ASTROAI_AUTH_ENABLED=true
# ASTROAI_API_AUTH_REQUIRED=true
# ASTROAI_AUTH_JWT_SECRET=<generate-a-random-secret-of-at-least-32-characters>
# ASTROAI_AUTH_JWKS_URL=
# ASTROAI_AUTH_JWT_ALGORITHM=HS256
# ASTROAI_AUTH_JWT_ISSUER=astroai
# ASTROAI_AUTH_JWT_AUDIENCE=astroai-api
#
# Managed OIDC alternative (do not also configure a symmetric secret):
# ASTROAI_AUTH_JWT_SECRET=
# ASTROAI_AUTH_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# ASTROAI_AUTH_JWT_ALGORITHM=RS256
# ASTROAI_PROFILE_DATABASE_PATH=/var/lib/astroai/profiles.db
